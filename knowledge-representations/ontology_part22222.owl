        <rdfs:comment>Organism that eats.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/alfsj019/ontologies/2022/10/untitled-ontology-10#Arachnid -->

    <owl:Class rdf:about="http://www.semanticweb.org/alfsj019/ontologies/2022/10/untitled-ontology-10#Arachnid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/alfsj019/ontologies/2022/10/untitled-ontology-10#Invertebrate"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/alfsj019/ontologies/2022/10/untitled-ontology-3#Eyes"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</xsd:minInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/alfsj019/ontologies/2022/10/untitled-ontology-3#Legs"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/alfsj019/ontologies/2022/10/untitled-ontology-3#warmBlooded"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Has eight legs and is more scary than insects.</rdfs:comment>
    </owl:Class>
    


